{
  "name": "medchain-backend",
  "version": "1.0.0",
  "description": "Backend server for MedChain with Ethereum blockchain",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "compile": "hardhat compile",
    "deploy": "node scripts/deploy.js",
